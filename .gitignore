# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# --- Python & Bytecode Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/
ENV/
backend/.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Test Caches & Coverage Outputs ---
.pytest_cache/
backend/.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage/
*.lprof

# --- Node & Frontend Build Outputs ---
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.local
.vite/

# --- Docker & Local Containers ---
.docker/

# --- OS & IDE Artifacts ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# --- Data Repository & Geospatial Datasets ---
# Exclude raw & processed satellite / raster binaries by default
data/raw/*
!data/raw/README.md
!data/raw/facilities/
data/processed/*
!data/processed/README.md
!data/processed/phase7/dataset/

# Heavy Satellite & Geospatial Binaries
*.geotiff
*.tiff
*.nc
*.hdf5
*.HDF5
*.gpkg
*.shp
*.dbf
*.zip
*.tar.gz

# --- Local Development Scratch & Logs ---
*.log
/test.csv
/walkthrough.md
scratch/
*.db
