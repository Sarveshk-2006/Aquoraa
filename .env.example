# Aquora Environment Configuration (.env.example)

# Runtime Environment Selector ('production', 'staging', 'development')
ENVIRONMENT=production

# Frontend API Base URL (Used by Vite build process and frontend API client)
VITE_API_BASE_URL=https://api.aquora.example.com

# Backend Core API Settings
API_BASE_URL=https://api.aquora.example.com
CORS_ORIGINS=["https://aquora.example.com","https://app.aquora.example.com"]
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL 15 + PostGIS 3.4)
DATABASE_URL=postgresql+asyncpg://aquora:SECURE_PASSWORD@postgres.aquora-db.internal:5432/aquora_db

# Redis Infrastructure Configuration (Redis 7)
REDIS_URL=redis://redis.aquora-cache.internal:6379/0

# Routing & OSRM Engine Configuration
ROUTING_PROVIDER=OSRM
ROUTING_BASE_URL=https://osrm.aquora.example.com

# Physical Flood Solver & Simulation Horizon Configuration
FLOOD_SIMULATION_TIMESTEP_MINUTES=10
FLOOD_SIMULATION_HORIZON_MINUTES=180
RUNOFF_MODEL=IMPERVIOUS_LOSS

# Real Data Provider Selectors
RAINFALL_PROVIDER=IMERG
FORECAST_PROVIDER=OPEN_METEO
TERRAIN_PROVIDER=COPERNICUS_GLO30
DRAINAGE_PROVIDER=OSM_MUMBAI
FACILITY_PROVIDER=LOCAL
INTERVENTION_PROVIDER=LOCAL
GROUND_TRUTH_PROVIDER=LOCAL_VERIFIED

# NASA Earthdata Credentials (Inject via deployment secrets manager)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# Persistent Storage & Artifact Paths
RAINFALL_RAW_DATA_PATH=data/raw/rainfall
RAINFALL_PROCESSED_DATA_PATH=data/processed/rainfall
DEM_RAW_DATA_PATH=data/raw/dem
DEM_PROCESSED_DATA_PATH=data/processed/dem
DRAINAGE_RAW_DATA_PATH=data/raw/drainage
DRAINAGE_PROCESSED_DATA_PATH=data/processed/drainage
FLOOD_RAW_DATA_PATH=data/raw/flood
FLOOD_PROCESSED_DATA_PATH=data/processed/flood
CRITICAL_FACILITIES_DATA_PATH=data/raw/facilities
INTERVENTION_CANDIDATE_DATA_PATH=data/raw/interventions

# Spatial Reference Systems
GEOSPATIAL_CANONICAL_CRS=EPSG:4326
GEOSPATIAL_DISPLAY_CRS=EPSG:3857
GEOSPATIAL_ANALYSIS_CRS=EPSG:32643

# Map Visualization Tile Style
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
